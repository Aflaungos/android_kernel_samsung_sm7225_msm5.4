/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Lagoon SoC";
	compatible = "qcom,lagoon";
	qcom,msm-id = <0x1b2 0x10000>, <0x1cb 0x10000>;
	interrupt-parent = <&intc>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;
	dtbo-version = <0x00>;

	chosen {
		bootargs = "log_buf_len=256K rcu_nocbs=0-7 rcupdate.rcu_expedited=1 kpti=off quiet noirqdebug cgroup.memory=nokmem";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x3a9>;

		hyp_region: hyp_region@80000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x80000000 0x00 0x600000>;
			phandle = <0x3aa>;
		};

		xbl_aop_mem: xbl_aop_mem@80700000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x80700000 0x00 0x160000>;
			phandle = <0x3ab>;
		};

		sec_apps_mem: sec_apps_region@808ff000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x808ff000 0x00 0x1000>;
			phandle = <0x3ac>;
		};

		smem_region: smem@80900000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0x8c>;
		};

		cdsp_sec_mem: cdsp_sec_regions@80b00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x80b00000 0x00 0x1e00000>;
			phandle = <0xe4>;
		};

		pil_camera_mem: camera_region@86000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x86000000 0x00 0x500000>;
			phandle = <0xd0>;
		};

		pil_npu_mem: pil_npu_region@86500000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x86500000 0x00 0x500000>;
			phandle = <0x99>;
		};

		pil_video_mem: pil_video_region@86a00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x86a00000 0x00 0x500000>;
			phandle = <0x98>;
		};

		pil_cdsp_mem: cdsp_regions@86f00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x86f00000 0x00 0x1e00000>;
			phandle = <0x2c>;
		};

		pil_adsp_mem: pil_adsp_region@88d00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x88d00000 0x00 0x2800000>;
			phandle = <0x26>;
		};

		wlan_fw_mem: wlan_fw_region@8b500000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8b500000 0x00 0x200000>;
			phandle = <0xad>;
		};

		pil_ipa_fw_mem: ipa_fw_region@8b700000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8b700000 0x00 0x10000>;
			phandle = <0xb2>;
		};

		pil_ipa_gsi_mem: ipa_gsi_region@8b710000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8b710000 0x00 0x5400>;
			phandle = <0x3ad>;
		};

		pil_gpu_mem: gpu_region@8b715400 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8b715400 0x00 0x2000>;
			phandle = <0x3ae>;
		};

		pil_modem_mem: modem_region@8b800000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8b800000 0x00 0xf800000>;
			phandle = <0x30>;
		};

		removed_region: removed_region@c0000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0xc0000000 0x00 0x3900000>;
			phandle = <0x3af>;
		};

		qseecom_mem: qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x23>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0xe3>;
		};

		secure_display_memory: secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x6800000>;
			phandle = <0xe5>;
		};

		cont_splash_memory: cont_splash_region {
			reg = <0x00 0xa0000000 0x00 0x2300000>;
			label = "cont_splash_region";
			phandle = <0x3b0>;
		};

		disp_rdump_memory: disp_rdump_region@0xa0000000 {
			reg = <0x00 0xa0000000 0x00 0x2300000>;
			label = "disp_rdump_region";
			phandle = <0x3b1>;
		};

		dfps_data_memory: dfps_data_region {
			reg = <0x00 0xa2300000 0x00 0x100000>;
			label = "dfps_data_region";
			phandle = <0x1f3>;
		};

		dump_mem: mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x2800000>;
			phandle = <0xb1>;
		};

		cmd_db: reserved-memory@80860000 {
			reg = <0x00 0x80860000 0x00 0x20000>;
			compatible = "qcom,cmd-db";
			no-map;
			phandle = <0x3b2>;
		};

		adsp_mem: adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0x90>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x8000000>;
			linux,cma-default;
		};
	};

	aliases: aliases {
		ufshc1 = "/soc/ufshc@1d84000";
		serial0 = "/soc/qcom,qup_uart@98c000";
		sdhc1 = "/soc/sdhci@7c4000";
		sdhc2 = "/soc/sdhci@8804000";
		swr0 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/wsa-macro@3240000/wsa_swr_master";
		swr1 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/rx-macro@3200000/rx_swr_master";
		swr2 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/tx-macro@3220000/tx_swr_master";
		phandle = <0x1f8>;
	};

	firmware: firmware {
		phandle = <0x209>;

		android {
			compatible = "android,firmware";

			shared_meta: vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo";
				phandle = <0x20a>;
			};

			android_q_fstab: fstab {
				compatible = "android,fstab";
				phandle = <0x20b>;

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "ok";
				};
			};
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x06>;
			next-level-cache = <&L2_0>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			#cooling-cells = <0x02>;
			phandle = <0x0e>;

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x03>;

				L3_0: l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x05>;
				};
			};

			L1_I_0: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x1f9>;
			};

			L1_D_0: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1fa>;
			};
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x06>;
			next-level-cache = <&L2_100>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			phandle = <0x0f>;

			L2_100: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x06>;
			};

			L1_I_100: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x1fb>;
			};

			L1_D_100: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1fc>;
			};
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x06>;
			next-level-cache = <&L2_200>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			phandle = <0x10>;

			L2_200: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x07>;
			};

			L1_I_200: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x1fd>;
			};

			L1_D_200: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x1fe>;
			};
		};

		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x06>;
			next-level-cache = <&L2_300>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			phandle = <0x11>;

			L2_300: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x08>;
			};

			L1_I_300: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x1ff>;
			};

			L1_D_300: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x200>;
			};
		};

		CPU4: cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x06>;
			next-level-cache = <&L2_400>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			phandle = <0x12>;

			L2_400: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x09>;
			};

			L1_I_400: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x201>;
			};

			L1_D_400: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x202>;
			};
		};

		CPU5: cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <&cpufreq_hw 0x00 0x06>;
			next-level-cache = <&L2_500>;
			qcom,lmh-dcvs = <&lmh_dcvs0>;
			phandle = <0x13>;

			L2_500: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x0a>;
			};

			L1_I_500: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x203>;
			};

			L1_D_500: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x204>;
			};
		};

		CPU6: cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x2bf>;
			qcom,freq-domain = <&cpufreq_hw 0x01 0x02>;
			next-level-cache = <&L2_600>;
			qcom,lmh-dcvs = <&lmh_dcvs1>;
			#cooling-cells = <0x02>;
			phandle = <0x14>;

			L2_600: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x0b>;
			};

			L1_I_600: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x205>;
			};

			L1_D_600: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x206>;
			};
		};

		CPU7: cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x2bf>;
			qcom,freq-domain = <&cpufreq_hw 0x01 0x02>;
			next-level-cache = <&L2_700>;
			qcom,lmh-dcvs = <&lmh_dcvs1>;
			phandle = <0x15>;

			L2_700: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <&L3_0>;
				phandle = <0x0d>;
			};

			L1_I_700: l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x207>;
			};

			L1_D_700: l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x208>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <&CPU0>;
				};

				core1 {
					cpu = <&CPU1>;
				};

				core2 {
					cpu = <&CPU2>;
				};

				core3 {
					cpu = <&CPU3>;
				};

				core4 {
					cpu = <&CPU4>;
				};

				core5 {
					cpu = <&CPU5>;
				};
			};

			cluster1 {

				core0 {
					cpu = <&CPU6>;
				};

				core1 {
					cpu = <&CPU7>;
				};
			};
		};
	};

	soc: soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x20c>;

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";
		};

		slim_aud: slim@3ac0000 {
			cell-index = <0x01>;
			compatible = "qcom,slim-ngd";
			reg = <0x3ac0000 0x2c000>, <0x3a84000 0x2a000>;
			reg-names = "slimbus_physical", "slimbus_bam_physical";
			interrupts = <0x00 0xa3 0x04>, <0x00 0xa4 0x04>;
			interrupt-names = "slimbus_irq", "slimbus_bam_irq";
			qcom,apps-ch-pipes = <0x00>;
			qcom,ea-pc = <0x380>;
			iommus = <&apps_smmu 0x1026 0x00>;
			qcom,iommu-dma-addr-pool = <0x40000000 0xc0000000>;
			qcom,iommu-dma = "fastmap";
			status = "ok";
			phandle = <0x20d>;

			btfmslim_codec: wcn3990 {
				compatible = "qcom,btfmslim_slave";
				elemental-addr = [00 01 20 02 17 02];
				qcom,btfm-slim-ifd = "btfmslim_slave_ifd";
				qcom,btfm-slim-ifd-elemental-addr = [00 00 20 02 17 02];
				phandle = <0x20e>;
			};
		};

		bluetooth: bt_wcn3990 {
			compatible = "qca,wcn3990";
			qca,bt-sw-ctrl-gpio = <&tlmm 0x45 0x00>;
			qca,bt-vdd-io-supply = <&L11A>;
			qca,bt-vdd-core-supply = <&L2E>;
			qca,bt-vdd-pa-supply = <&L10E>;
			qca,bt-vdd-xtal-supply = <&L7A>;
			qca,bt-vdd-io-voltage-level = <0x19f0a0 0x1cfde0>;
			qca,bt-vdd-core-voltage-level = <0x13e5c0 0x13e5c0>;
			qca,bt-vdd-pa-voltage-level = <0x2dc6c0 0x328980>;
			qca,bt-vdd-xtal-voltage-level = <0x19f0a0 0x1cfde0>;
			qca,bt-vdd-io-current-level = <0x01>;
			qca,bt-vdd-core-current-level = <0x01>;
			qca,bt-vdd-pa-current-level = <0x01>;
			qca,bt-vdd-xtal-current-level = <0x01>;
			phandle = <0x20f>;
		};

		intc: interrupt-controller@17a00000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			interrupt-controller;
			#redistributor-regions = <0x01>;
			redistributor-stride = <0x00 0x20000>;
			reg = <0x17a00000 0x10000>, <0x17a60000 0x100000>;
			interrupts = <0x01 0x08 0x04>;
			interrupt-parent = <&intc>;
			phandle = <0x01>;
		};

		jtag_mm0: jtagmm@7040000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7040000 0x1000>;
			reg-names = "etm-base";
			clocks = <&aopcc 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <&CPU0>;
			status = "disabled";
			phandle = <0x210>;
		};

		jtag_mm1: jtagmm@7140000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7140000 0x1000>;
			reg-names = "etm-base";
			clocks = <&aopcc 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <&CPU1>;
			status = "disabled";
			phandle = <0x211>;
		};

		jtag_mm2: jtagmm@7240000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7240000 0x1000>;
			reg-names = "etm-base";
			clocks = <&aopcc 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <&CPU2>;
			status = "disabled";
			phandle = <0x212>;
		};

		jtag_mm3: jtagmm@7340000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7340000 0x1000>;
			reg-names = "etm-base";
			clocks = <&aopcc 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <&CPU3>;
			status = "disabled";
			phandle = <0x213>;
		};

		jtag_mm4: jtagmm@7440000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7440000 0x1000>;
			reg-names = "etm-base";
			clocks = <&aopcc 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <&CPU4>;
			status = "disabled";
			phandle = <0x214>;
		};

		jtag_mm5: jtagmm@7540000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7540000 0x1000>;
			reg-names = "etm-base";
			clocks = <&aopcc 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <&CPU5>;
			status = "disabled";
			phandle = <0x215>;
		};

		jtag_mm6: jtagmm@7640000 {
