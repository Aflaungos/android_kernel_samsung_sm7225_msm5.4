		tsens0: tsens@c222000 {
			compatible = "qcom,tsens24xx";
			reg = <0xc222000 0x08>, <0xc263000 0x1ff>;
			reg-names = "tsens_srot_physical", "tsens_tm_physical";
			interrupts-extended = <&pdc 0x1a 0x04>, <&pdc 0x1c 0x04>, <&pdc 0x14 0x04>;
			interrupt-names = "tsens-upper-lower", "tsens-critical", "tsens-0C";
			0C-sensor-num = <0x10>;
			tsens-reinit-wa;
			#thermal-sensor-cells = <0x01>;
			phandle = <0x3a>;
		};

		tsens1: tsens@c223000 {
			compatible = "qcom,tsens24xx";
			reg = <0xc223000 0x08>, <0xc265000 0x1ff>;
			reg-names = "tsens_srot_physical", "tsens_tm_physical";
			interrupts-extended = <&pdc 0x1b 0x04>, <&pdc 0x1d 0x04>, <&pdc 0x15 0x04>;
			interrupt-names = "tsens-upper-lower", "tsens-critical", "tsens-0C";
			0C-sensor-num = <0x10>;
			tsens-reinit-wa;
			#thermal-sensor-cells = <0x01>;
			phandle = <0x3b>;
		};

		spmi_bus: qcom,spmi@c440000 {
			compatible = "qcom,spmi-pmic-arb";
			reg = <0xc440000 0x1100>, <0xc600000 0x2000000>, <0xe600000 0x100000>, <0xe700000 0xa0000>, <0xc40a000 0x26000>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			interrupt-names = "periph_irq";
			interrupts-extended = <&pdc 0x01 0x04>;
			qcom,ee = <0x00>;
			qcom,channel = <0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;
			cell-index = <0x00>;
			phandle = <0x257>;

			qcom,pm6350@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm6350_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x258>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
					interrupts = <0x00 0x08 0x00 0x03>, <0x00 0x08 0x01 0x03>;
					interrupt-names = "kpdpwr", "resin";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						qcom,pull-up;
						linux,code = <0x74>;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						qcom,pull-up;
						linux,code = <0x72>;
					};
				};

				pm6350_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x00 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x33>;
				};

				pm6350_clkdiv: clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm6350_div_clk1";
					clocks = <&rpmhcc 0x00>;
					clock-names = "xo";
					status = "disabled";
					phandle = <0x259>;
				};

				pm6350_gpios: pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0x900>;
					interrupts = <0x00 0xc0 0x00 0x00>, <0x00 0xc1 0x00 0x00>, <0x00 0xc2 0x00 0x00>, <0x00 0xc3 0x00 0x00>, <0x00 0xc4 0x00 0x00>, <0x00 0xc5 0x00 0x00>, <0x00 0xc6 0x00 0x00>, <0x00 0xc7 0x00 0x00>, <0x00 0xc8 0x00 0x00>;
					interrupt-names = "pm6350_gpio1", "pm6350_gpio2", "pm6350_gpio3", "pm6350_gpio4", "pm6350_gpio5", "pm6350_gpio6", "pm6350_gpio7", "pm6350_gpio8", "pm6350_gpio9";
					gpio-controller;
					#gpio-cells = <0x02>;
					phandle = <0x25a>;
				};
			};

			qcom,pm6350@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm6350_pwm: qcom,pwms@6000 {
					status = "disabled";
					compatible = "qcom,pwm-lpg";
					reg = <0x6000 0x100>;
					reg-names = "lpg-base";
					qcom,num-lpg-channels = <0x01>;
					#pwm-cells = <0x02>;
					phandle = <0x25b>;
				};
			};

			qcom,pm7250b@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pm7250b_revid: qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x73>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				pm7250b_charger: qcom,qpnp-smb5 {
					compatible = "qcom,qpnp-smb5";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					#cooling-cells = <0x02>;
					qcom,thermal-mitigation = <0x5265c0 0x44aa20 0x3d0900 0x3567e0 0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0xf4240 0x7a120>;
					qcom,pmic-revid = <&pm7250b_revid>;
					dpdm-supply = <&qusb_phy0>;
					phandle = <0x6f>;

					qcom,chgr@1000 {
						reg = <0x1000 0x100>;
						interrupts = <0x02 0x10 0x00 0x01>, <0x02 0x10 0x01 0x01>, <0x02 0x10 0x02 0x01>, <0x02 0x10 0x03 0x01>, <0x02 0x10 0x04 0x01>, <0x02 0x10 0x05 0x01>, <0x02 0x10 0x06 0x01>, <0x02 0x10 0x07 0x01>;
						interrupt-names = "chgr-error", "chg-state-change", "step-chg-state-change", "step-chg-soc-update-fail", "step-chg-soc-update-req", "fg-fvcal-qualified", "vph-alarm", "vph-drop-prechg";
					};

					qcom,dcdc@1100 {
						reg = <0x1100 0x100>;
						interrupts = <0x02 0x11 0x00 0x01>, <0x02 0x11 0x01 0x01>, <0x02 0x11 0x02 0x01>, <0x02 0x11 0x03 0x03>, <0x02 0x11 0x04 0x03>, <0x02 0x11 0x05 0x03>, <0x02 0x11 0x06 0x01>, <0x02 0x11 0x07 0x03>;
						interrupt-names = "otg-fail", "otg-oc-disable-sw", "otg-oc-hiccup", "bsm-active", "high-duty-cycle", "input-current-limiting", "concurrent-mode-disable", "switcher-power-ok";
					};

					qcom,batif@1200 {
