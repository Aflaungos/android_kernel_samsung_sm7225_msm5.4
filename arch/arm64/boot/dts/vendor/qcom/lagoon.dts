		msm_bus: qcom,kgsl-busmon {
			label = "kgsl-busmon";
			compatible = "qcom,kgsl-busmon";
			operating-points-v2 = <&gpu_opp_table>;
			phandle = <0x2a3>;
		};

		gpubw: qcom,gpubw {
			compatible = "qcom,devbw";
			governor = "bw_vbif";
			qcom,src-dst-ports = <0x1a 0x200>;
			operating-points-v2 = <&suspendable_ddr_bw_opp_table>;
			phandle = <0xc0>;
		};

		gpu_opp_table: gpu-opp-table {
			compatible = "operating-points-v2";
			phandle = <0xbf>;

			opp-850000000 {
				opp-hz = /bits/ 64 <0x32a9f880>;
				opp-microvolt = <0x180>;
			};

			opp-800000000 {
				opp-hz = /bits/ 64 <0x2faf0800>;
				opp-microvolt = <0x140>;
			};

			opp-650000000 {
				opp-hz = /bits/ 64 <0x26be3680>;
				opp-microvolt = <0x100>;
			};

			opp-565000000 {
				opp-hz = /bits/ 64 <0x21ad3740>;
				opp-microvolt = <0xc0>;
			};

			opp-430000000 {
				opp-hz = /bits/ 64 <0x19a14780>;
				opp-microvolt = <0x80>;
			};

			opp-355000000 {
				opp-hz = /bits/ 64 <0x1528dec0>;
				opp-microvolt = <0x60>;
			};

			opp-253000000 {
				opp-hz = /bits/ 64 <0xf147940>;
				opp-microvolt = <0x40>;
			};
		};

		msm_gpu: qcom,kgsl-3d0@3d00000 {
			label = "kgsl-3d0";
